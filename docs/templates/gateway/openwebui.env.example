# apps/openwebui/.env in the private marin-server-infra repository (the owner edits it there, not here).
# Open WebUI reads these only on a FRESH install: after the first start it keeps its connections in its own
# database, so the live cutover is done in the Admin Panel (docs/runbooks/02-chat-and-api-keys.md Part 5).
# Keep this file in step with the database so a fresh install matches the lab.
OPENAI_API_BASE_URL=https://ai.marin.cr/v1
# The service key named open-webui (kind service). The real value lives only in the private .env.
OPENAI_API_KEY=<LAI_SERVICE_KEY>
