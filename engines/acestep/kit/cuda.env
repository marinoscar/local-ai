# The music runtime for CUDA (kit item kit-engine-acestep-cuda), read by scripts/release/build-acestep-kit.sh.
# ACE-Step and nano-vllm are not on PyPI: they are built from the pinned commit and published as release
# assets. The interpreter is python-build-standalone: ACE-Step needs Python 3.11 or 3.12, and Ubuntu 26.04
# ships 3.14 (#511).
RUNTIME_VERSION=1.5.0
ACESTEP_GIT=https://github.com/ACE-Step/ACE-Step-1.5
ACESTEP_COMMIT=ca1e85fe9430179831e6bc6be790c332190a3866
NANOVLLM_SUBDIR=acestep/third_parts/nano-vllm
EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu128
PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.12.16%2B20261110-x86_64-unknown-linux-gnu-install_only.tar.gz
PYTHON_SUMS_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20261110/SHA256SUMS
