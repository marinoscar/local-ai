{
  "name": "ai-desktop",
  "productName": "ai-desktop",
  "desktopName": "ai-desktop.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for the Local AI node agent. Works fully offline.",
  "homepage": "https://github.com/marinoscar/local-ai",
  "license": "UNLICENSED",
  "author": {
    "name": "Local AI maintainers",
    "email": "noreply@marin.cr"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "dist": "node scripts/dist.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@localai/ui": "file:../../packages/ui",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "undici": "7.30.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
