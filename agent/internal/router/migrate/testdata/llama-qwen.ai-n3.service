# /etc/systemd/system/llama-qwen.service
[Unit]
Description=Qwen3.5-9B llama.cpp CUDA MTP Server
After=network.target

[Service]
Type=simple
User=labuser
Group=labuser
SupplementaryGroups=video render
WorkingDirectory=/home/labuser/llama.cpp
LoadCredential=llama-api-key:/etc/llama-qwen/api-key

ExecStart=/home/labuser/llama.cpp/build-cuda/bin/llama-server \
  -m /home/labuser/models/qwen3.5-9b-mtp/Qwen3.5-9B-Q4_K_M.gguf \
  -ngl 99 \
  --spec-type draft-mtp \
  --spec-draft-n-max 3 \
  -c 32768 \
  --parallel 1 \
  --flash-attn on \
  --alias qwen3.5-9b \
  --host 127.0.0.1 \
  --port 8080 \
  --api-key-file %d/llama-api-key

Restart=on-failure
RestartSec=5
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
